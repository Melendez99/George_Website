---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import WorkCard from '../components/WorkCard.astro';
import IntroVideo from '../components/IntroVideo.astro';
import VideoShowcase from '../components/VideoShowcase.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import { services } from '../data/services';
import testimonials from '../data/testimonials.json';
import Testimonial from '../components/Testimonial.astro';
import { SITE } from '../config';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const stack = ['n8n', 'Make.com', 'GoHighLevel', 'Zapier', 'Retell AI', 'Vapi', 'ElevenLabs', 'Twilio', 'Airtable', 'Supabase', 'Claude API', 'OpenAI', 'Astro', 'Vercel'];
const introVideoLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'George Melody: AI automation developer intro',
  description: 'A 55-second introduction to George Melody, an AI automation developer who builds n8n, Make.com, GoHighLevel and voice agent systems.',
  thumbnailUrl: new URL('/video/george-intro-poster.webp', Astro.site).href,
  contentUrl: new URL('/video/george-intro.mp4', Astro.site).href,
  uploadDate: '2026-10-21',
  duration: 'PT55S',
};
---
<Base jsonLd={[introVideoLd]}>
  <Hero />

  <section class="container-x py-12 max-w-4xl" id="intro">
    <IntroVideo />
  </section>

  <section class="container-x py-16">
    <SectionHead eyebrow="What I do" title="Automation that does a real job" sub="Pick a service to see what is included, the tools I use, and common questions." />
    <div class="grid gap-4 md:grid-cols-3">
      {services.map((s, i) => (
        <a href={`/services/${s.slug}`} class="card reveal group" style={`--d:${i * 70}ms`}>
          <Image src={s.image} alt={`${s.title} illustration`} widths={[480, 800, 1200]} sizes="(min-width: 768px) 33vw, 100vw" class="-mx-6 -mt-6 mb-5 w-[calc(100%+3rem)] max-w-none aspect-[2/1] object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 shrink-0 rounded-xl grid place-items-center bg-surface2 text-link"><Icon name={s.icon} /></div>
            <h3 class="text-xl font-semibold group-hover:text-link transition-colors">{s.title}</h3>
          </div>
          <p class="text-muted text-sm mt-3">{s.short}</p>
          <p class="mt-4 text-sm text-link inline-flex items-center gap-1">Learn more <span class="transition-transform group-hover:translate-x-1">→</span></p>
        </a>
      ))}
    </div>
  </section>

  {work.length > 0 && (
    <section class="container-x py-16">
      <SectionHead eyebrow="Selected work" title="Systems I have built" />
      <div class="grid gap-4 md:grid-cols-3">
        {work.map((w, i) => <WorkCard entry={w} delay={i * 80} />)}
      </div>
      <div class="reveal mt-8"><a href="/work" class="btn btn-ghost">All projects <span class="arrow">→</span></a></div>
    </section>
  )}

  <section class="container-x py-16" id="videos">
    <SectionHead eyebrow="Watch" title="See the systems running" sub="Short walkthroughs of real builds, recorded on my screen. Press play on any of them." />
    <VideoShowcase limit={3} />
    <div class="reveal mt-8"><a href="/work#videos" class="btn btn-ghost">All {7} video walkthroughs <span class="arrow">→</span></a></div>
  </section>

  <section class="py-12 overflow-hidden" aria-label="Tools I work with">
    <div class="marquee">
      {[...stack, ...stack].map((s) => <span class="font-mono text-sm text-muted whitespace-nowrap border border-line rounded-full px-4 py-2 bg-surface">{s}</span>)}
    </div>
  </section>

  {testimonials.length > 0 && (
    <section class="container-x py-16">
      <SectionHead eyebrow="Kind words" title="What clients say on Upwork" sub="Real reviews from completed Upwork contracts." />
      <div class="columns-1 md:columns-2 lg:columns-3 gap-4 [&>figure]:mb-4 [&>figure]:break-inside-avoid">
        {testimonials.filter((t: any) => t.quote.length < 520).slice(0, 6).map((t: any, i: number) => <Testimonial t={t} delay={i * 60} />)}
      </div>
      <div class="reveal mt-8"><a href="/reviews" class="btn btn-ghost">Read all {testimonials.length} reviews <span class="arrow">→</span></a></div>
    </section>
  )}

  {posts.length > 0 && (
    <section class="container-x py-16">
      <SectionHead eyebrow="From the blog" title="Notes on automation" />
      <div class="grid gap-4 md:grid-cols-3">
        {posts.map((p, i) => (
          <a href={`/blog/${p.id}`} class="card reveal block group" style={`--d:${i * 80}ms`}>
            {p.data.cover && <img src={p.data.cover} alt={p.data.title} width="1200" height="630" loading="lazy" decoding="async" class="-mx-6 -mt-6 mb-5 w-[calc(100%+3rem)] max-w-none aspect-[1200/630] object-cover" />}
            <p class="text-xs text-muted font-mono">{p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
            <h3 class="font-semibold text-lg mt-2 group-hover:text-link transition-colors">{p.data.title}</h3>
            <p class="text-muted text-sm mt-2">{p.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="container-x py-8">
    <a href="/scorecard" class="reveal card block group md:flex items-center justify-between gap-6 !p-8">
      <div>
        <p class="eyebrow">Free tool</p>
        <h2 class="text-2xl font-bold mt-1">How automatable is your business?</h2>
        <p class="text-muted mt-2">Answer 10 quick questions and get a score plus the first three things to automate. No sign-up.</p>
      </div>
      <span class="btn btn-primary mt-5 md:mt-0 shrink-0">Take the scorecard <span class="arrow">→</span></span>
    </a>
  </section>

  <section class="container-x py-16">
    <div class="reveal card !p-10 md:!p-14 text-center relative">
      <div class="absolute inset-0 -z-0 opacity-60" style="background: radial-gradient(60% 80% at 50% 0%, var(--glow), transparent 70%)"></div>
      <h2 class="text-3xl md:text-4xl font-bold">Got a process that eats your week?</h2>
      <p class="text-muted mt-3 max-w-xl mx-auto">Tell me what is slowing you down. I will tell you what can be automated and what it would take.</p>
      <div class="mt-7 flex flex-wrap gap-3 justify-center">
        <a href={SITE.bookUrl} target="_blank" rel="noopener" class="btn btn-primary">Book a call <span class="arrow">→</span></a>
        <a href="/contact" class="btn btn-ghost">Other ways to reach me</a>
      </div>
    </div>
  </section>
</Base>
