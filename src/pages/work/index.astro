---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkCard from '../../components/WorkCard.astro';
import Gallery from '../../components/Gallery.astro';
import VideoShowcase from '../../components/VideoShowcase.astro';
const more = [
  { file: 'wordpress-blog-automation.png', caption: 'n8n: AI blog engine from news ingestion and scoring to a published WordPress post' },
  { file: 'trend-seo-pipeline.png', caption: 'n8n: trending-topic research, writing and internal linking, then publishing to WordPress' },
  { file: 'social-content-factory.png', caption: 'n8n: one brief becomes posts for Instagram, Facebook, X and LinkedIn, with an approval step before publishing' },
  { file: 'whatsapp-booking-agent.png', caption: 'n8n: WhatsApp AI booking assistant with Cal.com booking and SMS reminders' },
  { file: 'sms-chat-buffer-redis.png', caption: 'n8n: a Twilio SMS agent that waits for a burst of messages and replies once, using Redis' },
  { file: 'retell-booking-agent.png', caption: 'n8n: Retell AI voice agent that checks Google Calendar availability and books the appointment' },
  { file: 'retell-inbound-lead-qualification.png', caption: 'n8n: Retell AI call transcript analysed by Gemini and written back to the lead in Airtable' },
  { file: 'woocommerce-support-agent.png', caption: 'n8n: AI support agent that looks up WooCommerce orders and DHL tracking' },
  { file: 'woocommerce-post-sales-chatbot.png', caption: 'n8n: post-sales chatbot with a policy knowledge base and human hand-off on Telegram' },
  { file: 'ai-sales-researcher.png', caption: 'n8n: AI company researcher that fills a Google Sheet with research on each account' },
];

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const cats = ['All', ...new Set(work.map((w) => w.data.category))];
---
<Base title="Work" description="Case studies of automation systems built with n8n, Make.com, GoHighLevel and AI voice agents.">
  <section class="container-x pt-36 pb-16">
    <SectionHead eyebrow="Work" title="Case studies" sub="A selection of systems I have built. Client names are kept private where needed." />
    <div class="flex flex-wrap gap-2 mb-8" id="filters" role="group" aria-label="Filter projects">
      {cats.map((c, i) => <button data-filter={c} class:list={['tag cursor-pointer transition', i === 0 && '!border-brand !text-link']}>{c}</button>)}
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" id="grid">
      {work.map((w, i) => <div data-cat={w.data.category}><WorkCard entry={w} delay={i * 60} /></div>)}
    </div>
  </section>
  <section class="container-x pb-16" id="videos">
    <SectionHead eyebrow="Watch" title="Video walkthroughs" sub="Short Loom recordings where I walk through real builds and show them running." />
    <VideoShowcase />
  </section>
  <section class="container-x pb-20">
    <SectionHead eyebrow="More builds" title="Workflow gallery" sub="More automations from my n8n and Make.com canvases. Click any image to enlarge." />
    <Gallery items={more} cols={3} />
  </section>
  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('#grid > [data-cat]');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.classList.remove('!border-brand', '!text-link'));
      b.classList.add('!border-brand', '!text-link');
      const f = b.dataset.filter;
      items.forEach((it) => (it.style.display = f === 'All' || it.dataset.cat === f ? '' : 'none'));
    }));
  </script>
</Base>
