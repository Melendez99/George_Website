---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkCard from '../../components/WorkCard.astro';
import Gallery from '../../components/Gallery.astro';
const more = [
  { file: 'make-lead-routing.png', caption: 'Make.com: lead routing from a webhook, matched to the right sub-account, then added to Brevo with a welcome email' },
  { file: 'wordpress-blog-automation.png', caption: 'n8n: AI blog engine from news ingestion and scoring to a published WordPress post' },
  { file: 'trend-seo-pipeline.png', caption: 'n8n: trending-topic research, writing and internal linking, then publishing to WordPress' },
  { file: 'ugc-video-autopilot.png', caption: 'n8n: product photos turned into UGC-style videos with Veo 3, Gemini and Airtable' },
];

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const cats = ['All', ...new Set(work.map((w) => w.data.category))];
---
<Base title="Work" description="Case studies of automation systems built with n8n, Make.com, GoHighLevel and AI voice agents.">
  <section class="container-x pt-36 pb-16">
    <SectionHead eyebrow="Work" title="Case studies" sub="A selection of systems I have built. Client names are kept private where needed." />
    <div class="flex flex-wrap gap-2 mb-8" id="filters" role="group" aria-label="Filter projects">
      {cats.map((c, i) => <button data-filter={c} class:list={['tag cursor-pointer transition', i === 0 && '!border-brand !text-link']}>{c}</button>)}
    </div>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" id="grid">
      {work.map((w, i) => <div data-cat={w.data.category}><WorkCard entry={w} delay={i * 60} /></div>)}
    </div>
  </section>
  <section class="container-x pb-20">
    <SectionHead eyebrow="More builds" title="Workflow gallery" sub="More automations from my n8n and Make.com canvases. Click any image to enlarge." />
    <Gallery items={more} />
  </section>
  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('#grid > [data-cat]');
    btns.forEach((b) => b.addEventListener('click', () => {
      btns.forEach((x) => x.classList.remove('!border-brand', '!text-link'));
      b.classList.add('!border-brand', '!text-link');
      const f = b.dataset.filter;
      items.forEach((it) => (it.style.display = f === 'All' || it.dataset.cat === f ? '' : 'none'));
    }));
  </script>
</Base>
