---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { industries } from '../../data/industries';
---
<Base title="Industries" description="AI automation for real estate, home services, coaches, creators and e-commerce. See builds for your industry.">
  <section class="container-x pt-36 pb-16">
    <SectionHead h1 eyebrow="Industries" title="Automation by industry" sub="The problems repeat across businesses of the same type. Here is what I build for each." />
    <div class="grid gap-4 md:grid-cols-2">
      {industries.map((n, i) => (
        <a href={`/industries/${n.slug}`} class="card reveal block group" style={`--d:${i * 60}ms`}>
          <h2 class="text-xl font-semibold group-hover:text-link transition-colors">{n.name}</h2>
          <p class="text-muted text-sm mt-2">{n.intro}</p>
          <p class="mt-4 text-sm text-link">See what I build <span>→</span></p>
        </a>
      ))}
    </div>
  </section>
</Base>
