---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkCard from '../../components/WorkCard.astro';
import { industries } from '../../data/industries';
export function getStaticPaths() { return industries.map((n) => ({ params: { slug: n.slug }, props: { n } })); }
const { n } = Astro.props;
const all = await getCollection('work');
const cases = n.work.map((id: string) => all.find((w) => w.id === id)).filter(Boolean);
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: n.faq.map((f: any) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Base title={n.headline} description={n.intro.slice(0, 160)} jsonLd={[faqLd]}>
  <section class="container-x pt-36 pb-10 max-w-4xl">
    <SectionHead h1 eyebrow={n.name} title={n.headline} sub={n.intro} />
    <div class="grid gap-4 md:grid-cols-2 mt-8">
      <div class="card"><h2 class="font-semibold text-lg">Problems I hear most</h2><ul class="mt-3 space-y-2 text-sm text-muted list-disc pl-4">{n.problems.map((p: string) => <li>{p}</li>)}</ul></div>
      <div class="card"><h2 class="font-semibold text-lg">What I build</h2><ul class="mt-3 space-y-2 text-sm text-muted list-disc pl-4">{n.builds.map((p: string) => <li>{p}</li>)}</ul></div>
    </div>
  </section>
  {cases.length > 0 && (
    <section class="container-x pb-12">
      <h2 class="font-display text-2xl font-semibold mb-5">Related case studies</h2>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{cases.map((w: any, i: number) => <WorkCard entry={w} delay={i * 60} />)}</div>
    </section>
  )}
  <section class="container-x pb-12 max-w-3xl">
    <h2 class="font-display text-2xl font-semibold mb-4">Questions</h2>
    <div class="space-y-3">{n.faq.map((f: any) => <details class="card !py-4"><summary class="cursor-pointer font-medium">{f.q}</summary><p class="text-sm text-muted mt-2">{f.a}</p></details>)}</div>
  </section>
  <section class="container-x pb-20">
    <div class="card text-center !py-10">
      <h2 class="font-display text-2xl font-semibold">Free consultation and audit</h2>
      <p class="text-muted mt-2 max-w-xl mx-auto">Book a free 30 minute call. I will review how your business runs today and tell you what is worth automating first.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3"><a href="/book" class="btn btn-primary">Book a free call <span class="arrow">→</span></a><a href="/packages" class="btn btn-ghost">See packages</a></div>
    </div>
  </section>
</Base>
