---
import { SITE } from '../config';
const links = [
  { href: '/work', label: 'Work' },
  { href: '/services', label: 'Services' },
  { href: '/packages', label: 'Packages' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="site fixed top-0 inset-x-0 z-50 py-3">
  <div class="container-x flex items-center justify-between gap-4">
    <a href="/" class="font-display font-bold text-lg tracking-tight flex items-center gap-2" aria-label={`${SITE.name} home`}>
      <img src="/favicon.svg" alt="" width="28" height="28" class="rounded-lg" />
      George<span class="grad-text">TheDeveloper</span>
    </a>
    <nav class="hidden md:flex items-center gap-1" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class:list={['px-3 py-2 rounded-full text-sm transition-colors hover:text-link', path.startsWith(l.href) ? 'text-ink' : 'text-muted']} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <button data-theme-toggle class="w-10 h-10 grid place-items-center rounded-full border border-line hover:border-brand transition" aria-label="Toggle light and dark theme">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <a href={SITE.bookUrl} target="_blank" rel="noopener" class="btn btn-primary hidden md:inline-flex">Book a call <span class="arrow">→</span></a>
      <button id="menu-btn" class="md:hidden w-10 h-10 grid place-items-center rounded-full border border-line" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="hidden md:hidden container-x mt-3 card !p-2" aria-label="Mobile">
    {links.map((l) => <a href={l.href} class="block px-4 py-3 rounded-xl hover:bg-surface2">{l.label}</a>)}
  </nav>
</header>
