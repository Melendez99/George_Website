---
const { entry, delay = 0 } = Astro.props;
import { Image } from 'astro:assets';
import { workImage } from '../lib/work-images';
const d = entry.data;
const shot = d.gallery?.[0] ? workImage(d.gallery[0].file) : undefined;
---
<a href={`/work/${entry.id}`} class="card reveal block group" style={`--d:${delay}ms`}>
  {!d.cover && shot && <Image src={shot} alt={d.title} widths={[480, 800]} sizes="(min-width: 1024px) 30vw, 90vw" loading="lazy" class="-mx-6 -mt-6 mb-5 w-[calc(100%+3rem)] max-w-none aspect-[1200/630] object-cover object-top" />}
  {d.cover && <img src={d.cover} alt={d.title} width="1200" height="630" loading="lazy" decoding="async" class="-mx-6 -mt-6 mb-5 w-[calc(100%+3rem)] max-w-none aspect-[1200/630] object-cover" />}
  <div class="flex items-center justify-between">
    <span class="tag">{d.category}</span>
    <span class="text-muted text-xs">{d.industry}</span>
  </div>
  <h3 class="text-xl font-semibold mt-4 group-hover:text-link transition-colors">{d.title}</h3>
  <p class="text-muted text-sm mt-2">{d.summary}</p>
  {d.metrics.length > 0 && (
    <div class="mt-4 flex gap-6">
      {d.metrics.slice(0, 2).map((m: any) => (<div><p class="font-display text-xl font-bold grad-text">{m.value}</p><p class="text-xs text-muted">{m.label}</p></div>))}
    </div>
  )}
  <div class="mt-5 flex flex-wrap gap-2">{d.stack.slice(0, 4).map((s: string) => <span class="tag">{s}</span>)}</div>
</a>
