---
const { entry, delay = 0 } = Astro.props;
const d = entry.data;
---
<a href={`/work/${entry.id}`} class="card reveal block group" style={`--d:${delay}ms`}>
  <div class="flex items-center justify-between">
    <span class="tag">{d.category}</span>
    <span class="text-muted text-xs">{d.industry}</span>
  </div>
  <h3 class="text-xl font-semibold mt-4 group-hover:text-link transition-colors">{d.title}</h3>
  <p class="text-muted text-sm mt-2">{d.summary}</p>
  {d.metrics.length > 0 && (
    <div class="mt-4 flex gap-6">
      {d.metrics.slice(0, 2).map((m: any) => (<div><p class="font-display text-xl font-bold grad-text">{m.value}</p><p class="text-xs text-muted">{m.label}</p></div>))}
    </div>
  )}
  <div class="mt-5 flex flex-wrap gap-2">{d.stack.slice(0, 4).map((s: string) => <span class="tag">{s}</span>)}</div>
</a>
