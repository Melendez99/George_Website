---
import { videos } from '../data/videos';
import LoomFacade from './LoomFacade.astro';
const { limit = videos.length, heading = true } = Astro.props as { limit?: number; heading?: boolean };
const list = videos.slice(0, limit);
---
<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
  {list.map((v, i) => (
    <article class="card reveal !p-0 overflow-hidden flex flex-col" style={`--d:${i * 60}ms`}>
      <LoomFacade id={v.id} title={v.title} tool={v.tool} />
      <div class="p-5 flex flex-col flex-1">
        <h3 class="font-semibold leading-snug">{v.title}</h3>
        <p class="text-xs text-link mt-1">Client: {v.client}</p>
        <p class="text-sm text-muted mt-2">{v.blurb}</p>
        <a href={`/work/${v.slug}`} class="mt-auto pt-4 text-sm text-link inline-flex items-center gap-1">Read the case study <span>→</span></a>
      </div>
    </article>
  ))}
</div>
