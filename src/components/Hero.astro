---
import { Image } from 'astro:assets';
import { SITE } from '../config';
import george from '../assets/george.png';
---
<section class="relative pt-28 md:pt-32">
  <div class="container-x">
    <div class="reveal flex items-center justify-between gap-4 border-b border-line pb-4 eyebrow">
      <span>Top Rated on Upwork</span>
      <span class="inline-flex items-center gap-2"><span class="dot-live"></span> Available for new projects</span>
    </div>

    <div class="grid lg:grid-cols-[1fr_auto] gap-8 lg:gap-12 items-center pt-10 md:pt-14">
      <div>
        <h1 class="reveal">
          I build AI automation that <em>runs your business</em> while you sleep.
        </h1>
      </div>
      <div class="reveal relative w-36 h-36 sm:w-44 sm:h-44 lg:w-64 lg:h-64 shrink-0 order-first lg:order-none" style="--d:120ms">
        <svg class="ring-text absolute inset-0 w-full h-full" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="ringpath" d="M100,100 m-86,0 a86,86 0 1,1 172,0 a86,86 0 1,1 -172,0" /></defs>
          <text fill="currentColor" font-size="12" class="font-sans uppercase"><textPath href="#ringpath" textLength="530" lengthAdjust="spacing">AI automation developer · n8n · Make · Voice agents ·</textPath></text>
        </svg>
        <Image src={george} alt="George Melody, AI automation developer" widths={[200, 400]} sizes="(min-width: 1024px) 200px, 140px" loading="eager" class="absolute inset-[16%] w-[68%] h-[68%] rounded-full object-cover" />
      </div>
    </div>

    <div class="reveal mt-10 md:mt-14 grid md:grid-cols-[1.2fr_1fr] gap-8 items-end" style="--d:160ms">
      <p class="text-muted max-w-xl">
        Hi, I'm George. I connect your tools, calls and leads into systems that work on their own, using
        <span id="typed" class="text-ink font-medium" data-words={JSON.stringify(SITE.roles)}>{SITE.roles[0]}</span><span class="caret" aria-hidden="true"></span>
      </p>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href="/work" class="btn btn-primary">See my work <span class="arrow">→</span></a>
        <a href={SITE.bookUrl} target="_blank" rel="noopener" class="btn btn-ghost">Book a call</a>
      </div>
    </div>

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-3 border-y border-line">
      {SITE.stats.map((s, i) => (
        <div class="reveal px-0 sm:px-7 py-7 sm:first:pl-0 sm:border-l sm:first:border-l-0 border-line max-sm:border-t max-sm:first:border-t-0" style={`--d:${i * 90}ms`}>
          <p class="font-display text-3xl md:text-4xl lg:text-5xl font-extrabold">
            {s.value !== undefined ? <span data-count={s.value} data-suffix={s.suffix ?? ''}>0{s.suffix}</span> : s.text}
          </p>
          <p class="text-xs text-muted mt-2">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Typing effect
  const typed = document.getElementById('typed');
  if (typed && !reduce) {
    const words: string[] = JSON.parse(typed.dataset.words || '[]');
    let w = 0, i = 0, del = false;
    const step = () => {
      const word = words[w];
      typed.textContent = word.slice(0, i);
      if (!del && i === word.length) { del = true; return setTimeout(step, 1600); }
      if (del && i === 0) { del = false; w = (w + 1) % words.length; return setTimeout(step, 300); }
      i += del ? -1 : 1;
      setTimeout(step, del ? 35 : 70);
    };
    typed.textContent = ''; step();
  }
</script>
