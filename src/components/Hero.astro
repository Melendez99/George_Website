---
import { Image } from 'astro:assets';
import { SITE } from '../config';
import george from '../assets/george.png';
---
<section class="relative isolate overflow-hidden pt-36 pb-24 md:pt-44 md:pb-32">
  <div class="hero-glow"></div>
  <canvas id="particles" class="absolute inset-0 -z-10 w-full h-full" aria-hidden="true"></canvas>
  <div class="absolute inset-x-0 bottom-0 h-40 -z-10 bg-gradient-to-t from-bg to-transparent"></div>

  <div class="container-x grid lg:grid-cols-[1.15fr_.85fr] gap-12 items-center">
    <div>
      <div class="reveal flex items-center gap-3">
        <Image src={george} alt="George Melody" width={96} height={96} densities={[1, 2]} loading="eager" class="h-12 w-12 rounded-full object-cover ring-2 ring-brand/70" />
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface/70 px-3 py-1.5 text-xs font-mono text-muted">
          <span class="dot-live"></span> Available for new projects
        </p>
      </div>
      <h1 class="reveal mt-6 text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05]" style="--d:80ms">
        I build AI automation that <span class="grad-text">runs your business</span> while you sleep.
      </h1>
      <p class="reveal mt-6 text-lg text-muted max-w-xl" style="--d:160ms">
        Hi, I'm George. I connect your tools, calls and leads into systems that work on their own, using
        <span id="typed" class="text-ink font-medium" data-words={JSON.stringify(SITE.roles)}>{SITE.roles[0]}</span><span class="caret" aria-hidden="true"></span>
      </p>
      <div class="reveal mt-8 flex flex-wrap gap-3" style="--d:240ms">
        <a href="/work" class="btn btn-primary">See my work <span class="arrow">→</span></a>
        <a href={SITE.bookUrl} target="_blank" rel="noopener" class="btn btn-ghost">Book a call</a>
      </div>
    </div>

    <!-- Animated workflow diagram -->
    <div class="reveal hidden lg:block" style="--d:300ms" aria-hidden="true">
      <svg viewBox="0 0 420 320" class="w-full drop-shadow-[0_20px_50px_rgba(56,182,255,.18)]">
        <defs>
          <linearGradient id="gl" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#38b6ff"/><stop offset="1" stop-color="#7c5cff"/></linearGradient>
        </defs>
        <g fill="none" stroke="url(#gl)" stroke-width="2" class="flow-line">
          <path d="M120 70 C 190 70, 170 160, 235 160"/>
          <path d="M120 250 C 190 250, 170 160, 235 160"/>
          <path d="M305 160 C 340 160, 330 80, 365 80"/>
          <path d="M305 160 C 340 160, 330 240, 365 240"/>
        </g>
        {[
          { x: 20, y: 40, t: 'Lead in', c: '#38b6ff' },
          { x: 20, y: 220, t: 'Missed call', c: '#2de2c0' },
          { x: 235, y: 130, t: 'AI agent', c: '#7c5cff' },
          { x: 335, y: 50, t: 'CRM', c: '#38b6ff' },
          { x: 335, y: 210, t: 'WhatsApp', c: '#2de2c0' },
        ].map((n) => (
          <g>
            <rect x={n.x} y={n.y} width={n.t === 'AI agent' ? 70 : 85} height="60" rx="14" fill="var(--surface)" stroke="var(--border)" />
            <circle cx={n.x + 16} cy={n.y + 18} r="5" fill={n.c} />
            <text x={n.x + 12} y={n.y + 44} font-size="12" font-family="JetBrains Mono Variable, monospace" fill="var(--text)">{n.t}</text>
          </g>
        ))}
      </svg>
    </div>
  </div>

  <div class="container-x mt-16 grid grid-cols-1 sm:grid-cols-3 gap-4">
    {SITE.stats.map((s, i) => (
      <div class="reveal card text-center !py-6" style={`--d:${i * 90}ms`}>
        <p class="font-display text-3xl font-bold grad-text">
          {s.value !== undefined ? <span data-count={s.value} data-suffix={s.suffix ?? ''}>0{s.suffix}</span> : s.text}
        </p>
        <p class="text-sm text-muted mt-1">{s.label}</p>
      </div>
    ))}
  </div>
</section>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Typing effect
  const typed = document.getElementById('typed');
  if (typed && !reduce) {
    const words: string[] = JSON.parse(typed.dataset.words || '[]');
    let w = 0, i = 0, del = false;
    const step = () => {
      const word = words[w];
      typed.textContent = word.slice(0, i);
      if (!del && i === word.length) { del = true; return setTimeout(step, 1600); }
      if (del && i === 0) { del = false; w = (w + 1) % words.length; return setTimeout(step, 300); }
      i += del ? -1 : 1;
      setTimeout(step, del ? 35 : 70);
    };
    typed.textContent = ''; step();
  }

  // Particle network (canvas, pauses offscreen and for reduced motion)
  const canvas = document.getElementById('particles') as HTMLCanvasElement | null;
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    let w = 0, h = 0, dpr = 1, raf = 0, visible = true;
    const mouse = { x: -999, y: -999 };
    type P = { x: number; y: number; vx: number; vy: number };
    let pts: P[] = [];
    const color = () => getComputedStyle(document.documentElement).getPropertyValue('--primary').trim() || '#38b6ff';

    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect(); w = r.width; h = r.height;
      canvas.width = w * dpr; canvas.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round(Math.min(70, (w * h) / 16000));
      pts = Array.from({ length: n }, () => ({ x: Math.random() * w, y: Math.random() * h, vx: (Math.random() - .5) * .35, vy: (Math.random() - .5) * .35 }));
    };
    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const c = color(); const link = 130;
      for (let i = 0; i < pts.length; i++) {
        const p = pts[i];
        if (!reduce) { p.x += p.vx; p.y += p.vy; if (p.x < 0 || p.x > w) p.vx *= -1; if (p.y < 0 || p.y > h) p.vy *= -1; }
        const dm = Math.hypot(p.x - mouse.x, p.y - mouse.y);
        if (dm < 140 && !reduce) { p.x += (p.x - mouse.x) * 0.004; p.y += (p.y - mouse.y) * 0.004; }
        ctx.globalAlpha = dm < 160 ? .95 : .55; ctx.fillStyle = c;
        ctx.beginPath(); ctx.arc(p.x, p.y, 1.6, 0, 6.283); ctx.fill();
        for (let j = i + 1; j < pts.length; j++) {
          const q = pts[j]; const d = Math.hypot(p.x - q.x, p.y - q.y);
          if (d < link) { ctx.globalAlpha = (1 - d / link) * (dm < 160 ? .5 : .22); ctx.strokeStyle = c; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke(); }
        }
      }
      ctx.globalAlpha = 1;
      if (!reduce && visible) raf = requestAnimationFrame(draw);
    };
    resize(); draw();
    addEventListener('resize', () => { resize(); if (reduce) draw(); });
    canvas.parentElement?.addEventListener('pointermove', (e) => { const r = canvas.getBoundingClientRect(); mouse.x = e.clientX - r.left; mouse.y = e.clientY - r.top; });
    canvas.parentElement?.addEventListener('pointerleave', () => { mouse.x = mouse.y = -999; });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible && !reduce) { cancelAnimationFrame(raf); raf = requestAnimationFrame(draw); } }).observe(canvas);
  }
</script>
